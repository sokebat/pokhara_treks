# Copy to .env or .env.local and fill in real values:
#   cp .env.example .env

# CockroachDB connection string from the Cloud console.
# Keep sslmode=verify-full (or require). Drizzle uses the Postgres dialect.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical app URL for auth callbacks.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site URL for metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin accounts for `pnpm db:seed`. JSON array. Real passwords only in .env.
SEED_ADMINS='[{"name":"Admin","email":"admin@pokharatreks.com","password":"change-me"}]'
